---
import '../styles/global.css';
import { getImage, Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { site, socials } from '../data/site';
import background from '../assets/brand/background.jpg';
import monogram from '../assets/brand/monogram.png';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Electronic music by Eric Shans`;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/releases/', label: 'Releases' },
  { href: '/photos/', label: 'Photos' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const bgLarge = await getImage({ src: background, width: 2200, format: 'webp', quality: 72 });
const bgSmall = await getImage({ src: background, width: 1100, format: 'webp', quality: 70 });
const ogImage = await getImage({ src: background, width: 1200, format: 'jpg' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#04040c" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="image" href={bgSmall.src} media="(max-width: 900px)" />
    <link rel="preload" as="image" href={bgLarge.src} media="(min-width: 901px)" />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-night"
      >Skip to content</a
    >

    <!-- fixed artwork backdrop (a fixed element, not background-attachment, so it also stays put on iOS) -->
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <picture>
        <source media="(max-width: 900px)" srcset={bgSmall.src} />
        <img src={bgLarge.src} alt="" class="h-full w-full object-cover opacity-90" />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-night/20 via-night/45 to-night/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,transparent_30%,var(--color-night)_100%)] opacity-60"></div>
    </div>

    <header class="sticky top-0 z-40 px-3 pt-3 sm:px-6 sm:pt-4">
      <div class="glass mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full py-2 pr-2 pl-4 sm:pl-5">
        <a href="/" class="flex shrink-0 items-center" aria-label="Phenotract home">
          <Image src={monogram} alt="" class="h-7 w-auto" />
        </a>
        <nav aria-label="Main" class="flex items-center gap-1">
          {
            nav.map((n) => (
              <a
                href={n.href}
                aria-current={isActive(n.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-3 py-1.5 text-sm font-semibold transition sm:px-4',
                  isActive(n.href) ? 'bg-white text-night' : 'text-white/75 hover:bg-white/10 hover:text-white',
                ]}
              >
                {n.label}
              </a>
            ))
          }
          <a
            href={site.spotify}
            target="_blank"
            rel="noopener"
            class="ml-1 hidden items-center gap-2 rounded-full bg-glow px-4 py-1.5 text-sm font-bold text-white shadow-[0_0_24px_-4px_var(--color-glow)] transition hover:bg-glow-soft sm:inline-flex"
          >
            <Icon icon={socials[0]!.icon} class="size-4" /> Listen
          </a>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mx-auto mt-24 w-full max-w-6xl px-5 pb-10 sm:px-8">
      <div class="flex flex-col items-center justify-between gap-6 border-t border-white/10 pt-8 sm:flex-row">
        <p class="spaced text-sm text-white/60">phenotract</p>
        <ul class="flex flex-wrap justify-center gap-1">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target={s.icon ? '_blank' : undefined}
                  rel={s.icon ? 'noopener' : undefined}
                  aria-label={s.name}
                  title={s.name}
                  class="grid size-10 place-items-center rounded-full text-white/60 transition hover:bg-white/10 hover:text-white"
                >
                  <Icon icon={s.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="mt-6 text-center text-xs text-white/35 sm:text-left">© {new Date().getFullYear()} Eric Shans</p>
    </footer>
  </body>
</html>
