---
import { Image } from 'astro:assets';
import type { Release } from '../data/site';

interface Props {
  release: Release;
  eager?: boolean;
}
const { release, eager = false } = Astro.props;
---

<a href={release.url} target="_blank" rel="noopener" class="group block">
  <div
    class="relative aspect-square overflow-hidden rounded-xl bg-white/5 ring-1 ring-white/10 transition duration-500 group-hover:-translate-y-1 group-hover:shadow-[0_18px_50px_-12px_var(--color-glow)] group-hover:ring-glow/60"
  >
    <Image
      src={release.cover}
      alt={`${release.title} cover art`}
      widths={[300, 600]}
      sizes="(min-width: 1024px) 270px, (min-width: 640px) 30vw, 46vw"
      loading={eager ? 'eager' : 'lazy'}
      class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
    />
    <span
      class="absolute right-3 bottom-3 grid size-9 translate-y-2 place-items-center rounded-full bg-white text-night opacity-0 transition group-hover:translate-y-0 group-hover:opacity-100"
      aria-hidden="true">↗</span
    >
  </div>
  <div class="mt-3 flex items-start justify-between gap-3">
    <h3 class="leading-snug font-semibold text-white group-hover:text-glow-soft">{release.title}</h3>
    {release.year && <span class="pt-0.5 font-display text-xs font-semibold tracking-wider text-white/45">{release.year}</span>}
  </div>
</a>
