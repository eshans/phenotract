---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found">
  <section class="mx-auto flex min-h-[60svh] max-w-6xl flex-col items-start justify-center px-5 sm:px-8">
    <p class="spaced text-sm text-glow-soft">404</p>
    <h1 class="mt-4 font-display text-4xl font-extrabold sm:text-6xl">Lost in the haze.</h1>
    <p class="mt-4 text-lg text-haze">That page doesn’t exist.</p>
    <a href="/" class="mt-8 rounded-full bg-white px-5 py-2.5 text-sm font-bold text-night hover:bg-haze">Back home</a>
  </section>
</Layout>
