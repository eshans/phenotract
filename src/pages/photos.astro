---
import { getImage, Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { photos } from '../data/site';

// full-size versions for the lightbox
const large = await Promise.all(photos.map((p) => getImage({ src: p.image, width: 1600, format: 'webp' })));
---

<Layout title="Photos" description="Press photos and artwork from Phenotract.">
  <section class="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-24">
    <header class="rise mb-12 border-b border-white/10 pb-8">
      <h1 class="spaced text-4xl sm:text-6xl">photos</h1>
    </header>

    <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        photos.map((p, i) => (
          <li class:list={[i === 0 && 'col-span-2 row-span-2']}>
            <button
              type="button"
              class="group block w-full overflow-hidden rounded-xl ring-1 ring-white/10 transition hover:ring-glow/60"
              data-full={large[i]!.src}
              data-alt={p.alt}
              aria-label={`View larger: ${p.alt}`}
            >
              <Image
                src={p.image}
                alt={p.alt}
                widths={[400, 800]}
                sizes={i === 0 ? '(min-width: 1024px) 540px, 92vw' : '(min-width: 1024px) 270px, 46vw'}
                loading={i < 4 ? 'eager' : 'lazy'}
                class="aspect-square w-full object-cover transition duration-700 group-hover:scale-105"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <dialog
    id="lightbox"
    class="m-auto max-h-[92svh] max-w-[92vw] bg-transparent p-0 backdrop:bg-night/90 backdrop:backdrop-blur-sm"
  >
    <form method="dialog">
      <button
        class="glass fixed top-4 right-4 grid size-11 place-items-center rounded-full text-xl text-white"
        aria-label="Close">×</button
      >
    </form>
    <img id="lightbox-img" src="" alt="" class="max-h-[92svh] max-w-[92vw] rounded-xl object-contain" />
  </dialog>
</Layout>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach((btn) => {
    btn.addEventListener('click', () => {
      img.src = btn.dataset.full!;
      img.alt = btn.dataset.alt ?? '';
      dialog.showModal();
    });
  });
  // click outside the image closes it
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
